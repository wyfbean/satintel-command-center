# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code local settings (machine-specific, not project config)
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build-*.log

# local verification artifacts
scripts/shot-*.png

# sqlite llm cache (generated at runtime)
data/

# python backend
backend/.venv/
**/__pycache__/
backend/.env
backend/uploads/
!backend/.env.example

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
