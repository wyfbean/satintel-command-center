# Copy to .env.local and fill in values before running.
# All variables are optional — the app runs in demo/anonymous mode without them.

# ── LLM (enables AI summaries, title translation, AI article generation) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # leave blank for openai.com
OPENAI_MODEL=gpt-4o-mini

# ── RSS / crawl sources (comma-separated URLs) ────────────────────────────
SATINTEL_RSS_SOURCES=https://spacenews.com/feed/,https://www.nasa.gov/rss/dyn/breaking_news.rss
SATINTEL_CRAWL_URLS=

# ── Authentication (NextAuth v5) ──────────────────────────────────────────
# Generate AUTH_SECRET: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple OAuth (optional — omit to disable Apple sign-in)
# Requires an Apple Developer account and a p8 private key.
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# Microsoft OAuth (optional — omit to disable Microsoft/Entra sign-in)
# Create an app at https://portal.azure.com → App registrations
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
# Leave TENANT_ID blank (or "common") for any Microsoft / personal account.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common
