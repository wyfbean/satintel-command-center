# Copy to .env. All optional: without OPENAI_API_KEY the backend runs deterministic
# mock mode (still exercises the bundled satellite MCP tools) so the chat works offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# A vision-capable model is required for real multimodal satellite-image VQA.
OPENAI_MODEL=gpt-4o-mini

# Model-machine defaults. Keep model weights on the data disk, not in this repo.
MODEL_WEIGHT_ROOT=/root/autodl-tmp/model_weight
MODEL_WRAPPERS_WEIGHTS_DIR=/root/autodl-tmp/model_weight/mw_weights
MODEL_WRAPPERS_OUTPUT_DIR=/root/autodl-tmp/model_outputs
DOFA_HEADS_DIR=/root/autodl-tmp/model_weight
SARMAE_HEADS_DIR=/root/autodl-tmp/model_weight/sarmae_seg_detect_weights
